{
  "expo": {
    "name": "OATH",
    "slug": "oath",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04050A",
    "splash": {
      "backgroundColor": "#04050A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oath.app"
    },
    "android": {
      "package": "com.oath.app",
      "adaptiveIcon": {
        "backgroundColor": "#04050A"
      }
    },
    "plugins": [
      "expo-blur",
      "expo-haptics"
    ]
  }
}
